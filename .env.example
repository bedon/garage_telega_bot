TELEGRAM_TOKEN=your_telegram_token_here

# Optional: LOG_LEVEL=INFO for verbose logs (default: ERROR)
# LOG_LEVEL=INFO

# Optional: Instagram account used by `make ig-login` to create a session.
# Only the login script reads these; the bot itself uses the saved session in
# data/instagram/. If the password is omitted, ig-login asks for it.
# Use a dedicated account: Instagram may lock accounts used for automation.
# INSTAGRAM_USERNAME=your_instagram_username
# INSTAGRAM_PASSWORD=your_instagram_password

# Optional overrides
# INSTAGRAM_DATA_DIR=data/instagram
# INSTAGRAM_COOKIES_FILE=/path/to/cookies.txt   # bring your own Netscape cookies file
# MAX_UPLOAD_MB=50
# MAX_PARALLEL_DOWNLOADS=2
